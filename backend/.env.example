# ── Service-to-service security ────────────────────────────────────────────────
# Shared bearer token for all /internal/v1/* routes between services.
# Leave empty to disable auth (safe for local dev with no exposed ports).
# On AWS: generate a random string and store in Secrets Manager.
INTERNAL_SERVICE_TOKEN=

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# CORS (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=semcachelm_cache
QDRANT_VECTOR_SIZE=768

# Redis (standalone uvicorn; use REDIS_MODE=local|aws|inherit like root .env)
REDIS_MODE=inherit
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_MODE=aws
# REDIS_AWS_HOST=your-endpoint.serverless.use1.cache.amazonaws.com
# REDIS_AWS_PORT=6379
# REDIS_AWS_PASSWORD=
# REDIS_AWS_SSL=true
# REDIS_MODE=local
# REDIS_LOCAL_HOST=localhost
# REDIS_LOCAL_PORT=6379

# ── Google Gemini (AI + RAG; required for inference and LlamaIndex embeddings) ──
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=120
# Optional: system prompt when orchestrator answers without RAG (plain LLM fallback). Empty = use built-in default.
# LLM_NO_RAG_SYSTEM_PROMPT=

# Decision thresholds
SIMILARITY_HIT_THRESHOLD=0.92
SIMILARITY_GRAY_ZONE_LOW=0.7

# Feedback / quality
QUALITY_EMA_ALPHA=0.2
QUALITY_EVICTION_THRESHOLD=0.3

# Cache search
CACHE_SEARCH_TOP_K=12

# LlamaIndex RAG (single repo URL, or https://github.com/<org-or-user> for multi-repo)
RAG_REPO_PATH=https://github.com/273-Team11-Proj
# Org/user mode: optional token (rate limits / private repos); limit caps clones; forks included by default (set false for upstream-only)
RAG_GITHUB_TOKEN=
RAG_ORG_REPO_LIMIT=25
RAG_ORG_INCLUDE_FORKS=true
RAG_REPO_CACHE_DIR=rag_repo_cache
RAG_TOP_K=4
# Below this best retrieval score (0–1), RAG returns empty; orchestrator uses plain LLM. 0 = off.
RAG_RETRIEVAL_SCORE_FLOOR=0.32
# LlamaIndex SIMPLE_SUMMARIZE QA template; must include {context_str} and {query_str}.
# RAG_SYNTHESIS_TEXT_QA_TEMPLATE=
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_CITATION_MAX_CHARS=260
RAG_REQUIRED_EXTS=.py,.md,.js,.jsx,.ts,.tsx,.json,.yml,.yaml,.toml
RAG_EXCLUDE_DIRS=.git,__pycache__,.pytest_cache,node_modules,.venv,venv,dist,build,.next

# Generated repo/API catalog docs for RAG
RAG_CATALOG_DIR=rag_catalog
RAG_CATALOG_STARTUP_GENERATE=false
RAG_CATALOG_REDIS_PREFIX=semcache:catalog
RAG_CATALOG_REPO_MAX_FILES=50
RAG_CATALOG_ENABLE_ROUTES=true

# Internal AI inference service controls
AI_INFERENCE_RETRY_ATTEMPTS=2
AI_INFERENCE_RATE_LIMIT_PER_MINUTE=120
AI_INFERENCE_COST_PER_1K_INPUT_TOKENS_USD=0.0001
AI_INFERENCE_COST_PER_1K_OUTPUT_TOKENS_USD=0.0004

# Standalone RAG/Catalog service (Phase C)
RAG_SERVICE_BASE_URL=http://localhost:8001
RAG_SERVICE_REQUEST_TIMEOUT_SECONDS=180.0

# Standalone Cache service (Phase D2)
CACHE_SERVICE_BASE_URL=http://localhost:8002
CACHE_SERVICE_REQUEST_TIMEOUT_SECONDS=60.0

# Standalone Analytics service (Phase E)
ANALYTICS_SERVICE_BASE_URL=http://localhost:8003
ANALYTICS_SERVICE_REQUEST_TIMEOUT_SECONDS=20.0

# Dual Qdrant (RAG chunks vs semantic cache; empty RAG_QDRANT_HOST falls back to QDRANT_HOST)
RAG_QDRANT_HOST=
RAG_QDRANT_PORT=0
RAG_QDRANT_COLLECTION=semcachelm_rag_chunks
RAG_QDRANT_VECTOR_SIZE=0

# RAG: Qdrant per-repo collections + Redis manifest keys (fingerprints / rebuild bookkeeping)
RAG_REDIS_MANIFEST_PREFIX=semcache:rag:index:v1

# Gateway calls standalone AI over HTTP
AI_SERVICE_BASE_URL=http://localhost:8004
AI_SERVICE_REQUEST_TIMEOUT_SECONDS=120

# Gateway calls standalone Orchestrator for sync query path
ORCHESTRATOR_SERVICE_BASE_URL=http://localhost:8005
ORCHESTRATOR_SERVICE_REQUEST_TIMEOUT_SECONDS=120

# Async query pipeline (Redis Streams + standalone orchestrator service) — default on
QUERY_JOB_TTL_SECONDS=3600
ORCHESTRATOR_STEP_TIMEOUT_SECONDS=120
ORCHESTRATOR_CONSUMER_GROUP=cg-orchestrator
ORCHESTRATOR_CONSUMER_NAME_SUFFIX=
ANALYTICS_VIA_STREAM=true
ANALYTICS_STREAM_CONSUMER_ENABLED=true
STREAM_WORKERS_ENABLED=true
STREAM_MAX_DELIVERY_ATTEMPTS=4
STREAM_RECLAIM_MIN_IDLE_MS=60000
CMD_RESULT_TTL_SECONDS=7200
