# Application
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# CORS (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=semcachelm_cache
QDRANT_VECTOR_SIZE=768

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120

# Decision thresholds
SIMILARITY_HIT_THRESHOLD=0.92
SIMILARITY_GRAY_ZONE_LOW=0.7

# Feedback / quality
QUALITY_EMA_ALPHA=0.2
QUALITY_EVICTION_THRESHOLD=0.3

# Cache search
CACHE_SEARCH_TOP_K=5

# LlamaIndex RAG (single repository)
RAG_REPO_PATH=https://github.com/dhruvj014/Sem-Cache-LM
RAG_REPO_CACHE_DIR=.rag_repo_cache
RAG_INDEX_DIR=.rag_index
RAG_TOP_K=4
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_CITATION_MAX_CHARS=260
RAG_REQUIRED_EXTS=.py,.md,.js,.jsx,.ts,.tsx,.json,.yml,.yaml,.toml
RAG_EXCLUDE_DIRS=.git,__pycache__,.pytest_cache,node_modules,.venv,venv,dist,build,.next

# Generated repo/API catalog docs for RAG
RAG_CATALOG_DIR=rag_catalog
RAG_CATALOG_STARTUP_GENERATE=true
RAG_CATALOG_REDIS_PREFIX=semcache:catalog
RAG_CATALOG_REPO_MAX_FILES=50
RAG_CATALOG_ENABLE_ROUTES=true
