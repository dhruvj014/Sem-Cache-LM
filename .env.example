# SemCacheLM root env (used by docker-compose)
# Copy this file to `.env` to override defaults for your local machine.

# ── Redis target (all backend services) ───────────────────
# inherit — use REDIS_HOST / REDIS_PORT / REDIS_SSL / REDIS_PASSWORD only.
# local   — use REDIS_LOCAL_*; TLS off; use with: docker compose --profile local-infra up
# aws     — use REDIS_AWS_*; TLS defaults true (ElastiCache Serverless, Redis Cloud, …).
REDIS_MODE=inherit

# docker-compose.aws.yml: defaults to in-compose Redis (REDIS_MODE=local, service name `redis`).
# Use ElastiCache instead by setting REDIS_MODE=aws and REDIS_AWS_HOST (and auth/SSL as needed).

# ── Infra ports (host-side) ──────────────────────────────
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
REDIS_PORT=6379

# ── Frontend ─────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Grafana observability login ──────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# ── Google Gemini (required for AI + RAG services in Compose) ──
GEMINI_API_KEY=

# Optional outbound proxy for Gemini HTTPS from Docker (corporate networks)
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1,redis,qdrant,ai,rag,cache

# ── Qdrant Cloud (optional) ──────────────────────────────
# To use Qdrant Cloud instead of local Qdrant, set these:
QDRANT_HOST=your-cluster-url.qdrant.tech
QDRANT_PORT=443
QDRANT_HTTPS=true
QDRANT_API_KEY=your_api_key

# docker-compose.aws.yml: local Qdrant container is OFF by default. Use Qdrant Cloud vars above.
# To run the bundled Qdrant image on EC2 instead: docker compose --profile bundled-qdrant …
# and set QDRANT_HOST=qdrant, QDRANT_PORT=6333, QDRANT_HTTPS=false (and matching RAG_QDRANT_*).

# ── RAG Qdrant Cloud (optional) ──────────────────────────
# Separate RAG cluster if needed (defaults to QDRANT_* if empty)
RAG_QDRANT_HOST=your-rag-cluster-url.qdrant.tech
RAG_QDRANT_PORT=443
RAG_QDRANT_HTTPS=true
RAG_QDRANT_API_KEY=your_rag_api_key

# RAG: skip synthesis when best chunk score is below this (0–1); orchestrator then uses plain LLM.
# Set 0 to always synthesize whenever any chunk is retrieved. Typical: 0.28–0.40.
# RAG_RETRIEVAL_SCORE_FLOOR=0.32
# RAG synthesis (LlamaIndex): custom QA prompt; must include {context_str} and {query_str}.
# RAG_SYNTHESIS_TEXT_QA_TEMPLATE=

# ── Redis: inherit mode (manual host / legacy) ───────────
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_SSL=false

# ── Redis: local mode (Compose profile `local-infra`) ─────
# REDIS_MODE=local
# REDIS_LOCAL_HOST=redis
# REDIS_LOCAL_PORT=6379
# REDIS_LOCAL_PASSWORD=

# ── Redis: docker-compose.aws.yml ─────────────────────────
# Default: in-compose `redis` + REDIS_MODE=local (no ElastiCache SG/TLS).
# For ElastiCache / Redis Cloud instead:
# REDIS_MODE=aws
# REDIS_AWS_HOST=your-endpoint.serverless.use1.cache.amazonaws.com
# REDIS_AWS_PORT=6379
# REDIS_AWS_PASSWORD=
# REDIS_AWS_SSL=true
