# SemCacheLM root env (used by docker-compose)
# Copy this file to `.env` to override defaults for your local machine.

# ── Infra ports (host-side) ──────────────────────────────
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
REDIS_PORT=6379

# ── Frontend ─────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Grafana observability login ──────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# ── Ollama (runs on host machine, not in Docker) ─────────
# Make sure Ollama is running before docker compose up:
#   ollama serve
#   ollama pull llama3.1:8b
#   ollama pull nomic-embed-text
# Containers reach the host via host.docker.internal (already
# configured in docker-compose.yml extra_hosts).
OLLAMA_BASE_URL=http://host.docker.internal:11434
